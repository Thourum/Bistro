<component name="ProjectRunConfigurationManager">
  <!-- Starts Go under a headless Delve debug server on :2345.
       Use "bistro-sync: Attach (Remote)" to connect GoLand's debugger.
       Set BISTRO_SKIP_GO_SPAWN=1 in the Electron run config to prevent a second spawn. -->
  <configuration default="false" name="bistro-sync: Headless (dlv)" type="ShRunConfigurationType" factoryName="Shell Script">
    <option name="SCRIPT_TEXT" value="dlv debug --headless --listen=:2345 --api-version=2 --accept-multiclient ./cmd/bistro-sync -- -ws-port 8080 -db-path ./data/sync.db -log-level debug" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="/bin/sh" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="EXECUTE_IN_TERMINAL" value="true" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$/go" />
    <envs>
      <env name="GITHUB_CLIENT_ID" value="" />
      <env name="GITHUB_CLIENT_SECRET" value="" />
    </envs>
    <method v="2" />
  </configuration>
</component>
