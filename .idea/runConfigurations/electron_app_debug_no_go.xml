<component name="ProjectRunConfigurationManager">
  <!-- Electron debug with --inspect=9229, Go spawn SKIPPED.
       Used by "Full App: Debug" compound where Go runs separately under Delve.
       Do NOT use standalone — Go must already be running on :8080. -->
  <configuration default="false" name="Electron: App (Debug, No Go)" type="js.build_tools.npm" factoryName="npm">
    <package-json value="$PROJECT_DIR$/electron/package.json" />
    <command value="run" />
    <scripts>
      <script value="electron:app:debug" />
    </scripts>
    <node-interpreter value="project" />
    <envs>
      <env name="GITHUB_CLIENT_ID" value="" />
      <env name="GITHUB_CLIENT_SECRET" value="" />
      <env name="BISTRO_SKIP_GO_SPAWN" value="1" />
    </envs>
    <method v="2" />
  </configuration>
</component>
