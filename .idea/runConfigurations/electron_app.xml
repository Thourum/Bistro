<component name="ProjectRunConfigurationManager">
  <!-- Full app: Vite dev server + tsc watch + Electron (which spawns Go binary).
       Before launch builds the Go binary so Electron can spawn it. -->
  <configuration default="false" name="Electron: App" type="js.build_tools.npm" factoryName="npm">
    <package-json value="$PROJECT_DIR$/electron/package.json" />
    <command value="run" />
    <scripts>
      <script value="electron:app" />
    </scripts>
    <node-interpreter value="project" />
    <envs>
      <env name="GITHUB_CLIENT_ID" value="" />
      <env name="GITHUB_CLIENT_SECRET" value="" />
    </envs>
    <method v="2">
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="bistro-sync: Build" run_configuration_type="ShRunConfigurationType" />
    </method>
  </configuration>
</component>
