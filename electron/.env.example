# Bistro Electron — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# WebSocket port the Go sync engine listens on (default: 8080)
WS_PORT=8080

# Log level passed to the Go sync process: debug | info | warn | error (default: info)
GO_LOG_LEVEL=info

# App window dimensions (defaults: 1600 x 900)
APP_WINDOW_WIDTH=1600
APP_WINDOW_HEIGHT=900

# GitHub OAuth credentials — required for authentication
# Register an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URL=http://localhost:3000/callback
