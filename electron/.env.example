# Bistro Electron — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# WebSocket port the Go sync engine listens on (default: 8080)
WS_PORT=8080

# Log level passed to the Go sync process: debug | info | warn | error (default: info)
GO_LOG_LEVEL=info

# App window dimensions (defaults: 1600 x 900)
APP_WINDOW_WIDTH=1600
APP_WINDOW_HEIGHT=900

# GitHub OAuth credentials — GITHUB_CLIENT_ID is required for authentication
# Register an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
# Optional, dev-only. With it, the engine exchanges the OAuth code with GitHub directly.
# Without it, the code goes through https://get-bistro.com/api/oauth/token (the packaged-build path).
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URL=http://localhost:3000/callback

# Optional crash reporting endpoint for release builds. A DSN alone does not enable
# collection; crash reporting is gated by Settings → Privacy → Usage Telemetry.
# Do not commit real DSNs or auth tokens.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional update checks are disabled by default in packaged builds.
# Set BISTRO_ENABLE_AUTO_UPDATES=1 only for builds that should check GitHub
# releases through Electron's public update service.
BISTRO_ENABLE_AUTO_UPDATES=0
BISTRO_DISABLE_AUTO_UPDATES=0
