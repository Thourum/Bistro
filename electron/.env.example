# Bistro Electron — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file containing real secrets.

# Path to the Go sync engine binary (relative to app root or absolute)
# Defaults to ./bistro-sync in the same directory as the Electron binary
BISTRO_GO_BINARY_PATH=./bistro-sync

# WebSocket port the Go process listens on
# Go process will write the actual port to stdout on startup
BISTRO_WS_PORT=8765

# SQLite database path (relative to user data dir or absolute)
# Defaults to <userData>/bistro.db
BISTRO_DB_PATH=

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# Enable Electron DevTools in production builds (set to true for debugging)
BISTRO_DEVTOOLS=false

# App update server URL (optional, for auto-updates)
# BISTRO_UPDATE_URL=https://updates.example.com/bistro
