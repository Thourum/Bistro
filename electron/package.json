{
  "name": "bistro-electron",
  "productName": "Bistro",
  "version": "0.1.0-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Itterno/Bistro.git"
  },
  "main": ".vite/build/index.cjs",
  "scripts": {
    "start": "pnpm exec electron-forge start",
    "start:debug": "pnpm exec electron-forge start --inspect-electron",
    "build": "cd ../go && go build -o bistro-sync ./cmd/bistro-sync",
    "build:engine": "node --env-file-if-exists=.env.local scripts/build-engine.mjs",
    "package": "pnpm run build:engine && pnpm exec electron-forge package --platform=darwin --arch=arm64",
    "release:macos": "pnpm run build:engine && pnpm exec electron-forge make --platform=darwin --arch=arm64",
    "release:win": "pnpm run build && pnpm exec electron-forge make --platform=win32 --targets=@electron-forge/maker-zip",
    "publish:github": "pnpm run build:engine && pnpm exec electron-forge publish --platform=darwin --arch=arm64",
    "dev:web": "pnpm exec vite --config vite.renderer.config.ts",
    "dev:renderer": "pnpm run dev:web",
    "bench:large-diff": "node --no-warnings --experimental-strip-types scripts/bench-large-diff.mjs",
    "type-check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "biome check src"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "^1.5.2",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-hover-card": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/electron": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/hotkeys": "^0.11.0",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-virtual": "^3.14.15",
    "@tanstack/store": "^0.11.2",
    "@thourum/fault": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "execa": "^10.1.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "mermaid": "^12.1.0",
    "pino": "^10.4.0",
    "posthog-node": "^5.55.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "ts-deepmerge": "^8.0.0",
    "update-electron-app": "^3.3.0",
    "wait-on": "^9.5.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "44.7.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
